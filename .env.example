# Relay settings
# The internal address/port the relay listens on
RELAY_ADDR=:43211
# The port the Next.js web panel listens on
PORT=8090
RELAY_TOKEN_SECRET=dev-token-secret-change-in-prod
RELAY_DB_KEY=dev-db-key-change-in-prod
RELAY_ADMIN_TOKEN=dev-admin-token-change-in-prod
UPSTREAM_BASE_URL=https://gorouter.app

# Web admin panel settings
# Admin account: Jubin
ADMIN_USER=Jubin
# The hash for "password" (use npm run hash-password to generate a new one)
ADMIN_PASSWORD_HASH=scrypt:e775ad91012f6e3efbe29c6f5906fefd:ea200e7d4c043d55473feb944f9ec9c7afd0a85c709a080b92d678a1425135bdf34ea194dd7d9308a8620ace313936d41f11f7af34038523e96ac9311bf9f367
SESSION_SECRET=dev-session-secret-change-in-prod

# Caddy settings (only needed if using the caddy service)
WEB_HOST=panel.example.com
RELAY_HOST=api.example.com

# ---------------------------------------------------------------------------
# Client auth token. If set, callers must present it via
# Authorization: Bearer <token> or x-api-key. Empty = no client auth
# ---------------------------------------------------------------------------
AUTH_TOKEN=

# How claude-proxy talks to the upstream: anthropic | openai.
UPSTREAM_FORMAT=anthropic

# Your upstream API key.
UPSTREAM_API_KEY=sk-your-upstream-key-here

# Default model used when a client does not name one.
DEFAULT_MODEL=claude-opus-4-8

# Model mapping. Comma-separated from=to pairs
MODEL_MAP=

# Anthropic requires max_tokens.
DEFAULT_MAX_TOKENS=4096

# Streaming keep-alive ping cadence (seconds)
STREAM_IDLE_PING_SECONDS=15

# Overall per-request timeout in MILLISECONDS. 0 = none.
TIMEOUT=0

# Logging.
LOG_LEVEL=info
LOG_FORMAT=text
LOG_BODIES=false
