# Copy to .env next to the claude-proxy binary. Everything here is optional
# except your GoRouter key. Real environment variables win over this file at
# startup. The dashboard (http://127.0.0.1:3001/) writes changes back here.

# ---------------------------------------------------------------------------
# Server bind. Keep HOST on localhost: claude-proxy holds your GoRouter key, so
# binding 0.0.0.0 without AUTH_TOKEN exposes it to anyone who can reach the port.
# ---------------------------------------------------------------------------
HOST=127.0.0.1
PORT=3001

# Client auth token. If set, callers (Trae, Claude Code) must present it via
# Authorization: Bearer <token> or x-api-key. Empty = no client auth (localhost
# trust) and any key the client sends is ignored in favor of UPSTREAM_API_KEY.
AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Upstream: the router claude-proxy forwards to. Default is GoRouter.
#   GoRouter:     https://gorouter.app
#   AgentRouter:  https://agentrouter.org
#   Anthropic:    https://api.anthropic.com
# Do NOT include a trailing /v1 - claude-proxy appends the correct path itself.
# ---------------------------------------------------------------------------
UPSTREAM_BASE_URL=https://gorouter.app

# How claude-proxy talks to the upstream: anthropic | openai.
#   anthropic (default) -> native passthrough to GoRouter's /v1/messages. Lossless
#                          for Claude: keeps tools, cache_control, thinking, betas.
#   openai              -> translate to /v1/chat/completions.
UPSTREAM_FORMAT=anthropic

# Your GoRouter API key (the token from the GoRouter Tokens page).
UPSTREAM_API_KEY=sk-your-gorouter-key-here

# Default model the CLI launcher and dashboard test box use.
DEFAULT_MODEL=claude-opus-4-8

# ---------------------------------------------------------------------------
# Model mapping. Comma-separated from=to pairs; left = what the client sends,
# right = the exact GoRouter model id. "*" is a catch-all. Example:
#   MODEL_MAP=claude-3-5-sonnet-20241022=claude-opus-4-8,*=claude-opus-4-8
# Empty = pass model names through untouched.
# ---------------------------------------------------------------------------
MODEL_MAP=

# Anthropic requires max_tokens. When an OpenAI-format client omits it and the
# upstream is Anthropic, claude-proxy fills in this value.
DEFAULT_MAX_TOKENS=4096

# Streaming keep-alive ping cadence (seconds) on the translating path. Claude
# Code aborts a stream silent for 300s. 0 disables.
STREAM_IDLE_PING_SECONDS=15

# Overall per-request timeout in MILLISECONDS. 0 = none (recommended for long
# agentic streams).
TIMEOUT=0

# Logging.
LOG_LEVEL=info
LOG_FORMAT=text
LOG_BODIES=false
